# ============================================================
# Konfigurasi Aplikasi AuditToko AI (shopee-profit-auditor)
# TEMPLATE — Salin ke .env.local dan isi kunci rahasia Anda.
# Jangan pernah mengunggah .env.local ke GitHub (sudah terdaftar di .gitignore).
# ============================================================

# 1. Google Gemini AI (Gratis dari https://aistudio.google.com/apikey)
# Gunakan untuk fitur analisis AI yang akan ditambahkan.
GEMINI_API_KEY=masukkan_gemini_api_key_anda_di_sini

# 2. Daftar Kode Voucher Promo 1x Pakai
# Pisahkan dengan koma. Pencocokan case-sensitive (huruf besar/kecil harus persis sama).
NEXT_PUBLIC_VOUCHER_CODES=AuditVIP01,AuditVIP02,AuditVIP03,PromoToko99

# 3. Payment Gateway QRIS Asli — Midtrans
# Isi nanti saat siap menerima pembayaran asli. Saat ini masih simulasi lokal.
MIDTRANS_SERVER_KEY=masukkan_midtrans_server_key_anda_di_sini
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=masukkan_midtrans_client_key_anda_di_sini
MIDTRANS_IS_PRODUCTION=false

# 4. Harga Layanan Audit (Rupiah)
NEXT_PUBLIC_AUDIT_PRICE=15000